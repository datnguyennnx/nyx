{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "snapshots": false,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "default_agent": "ship-mas",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "**/*.env*", "effect": "deny" },
    { "action": "read", "resource": "**/*secret*", "effect": "deny" },
    { "action": "read", "resource": "**/*credential*", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "read", "resource": "**/.gnupg/**", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "**/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "**/service.json", "effect": "deny" },
    { "action": "read", "resource": "**/cli.json", "effect": "deny" },
    { "action": "read", "resource": "**/auth.json", "effect": "deny" },
    { "action": "glob", "resource": "**/*.env*", "effect": "deny" },
    { "action": "glob", "resource": "**/*secret*", "effect": "deny" },
    { "action": "glob", "resource": "**/*credential*", "effect": "deny" },
    { "action": "glob", "resource": "**/*.pem", "effect": "deny" },
    { "action": "glob", "resource": "**/*.key", "effect": "deny" },
    { "action": "glob", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "glob", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "glob", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "glob", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "glob", "resource": "**/.gnupg/**", "effect": "deny" },
    { "action": "grep", "resource": "**/*.env*", "effect": "deny" },
    { "action": "grep", "resource": "**/*secret*", "effect": "deny" },
    { "action": "grep", "resource": "**/*credential*", "effect": "deny" },
    { "action": "grep", "resource": "**/*.pem", "effect": "deny" },
    { "action": "grep", "resource": "**/*.key", "effect": "deny" },
    { "action": "grep", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "grep", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "grep", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "grep", "resource": "**/.aws/**", "effect": "deny" },
    { "action": "grep", "resource": "**/.gnupg/**", "effect": "deny" },
    { "action": "grep", "resource": "**/.netrc", "effect": "deny" },
    { "action": "grep", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "grep", "resource": "**/.git-credentials", "effect": "deny" },
    { "action": "grep", "resource": "**/service.json", "effect": "deny" },
    { "action": "grep", "resource": "**/cli.json", "effect": "deny" },
    { "action": "grep", "resource": "**/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "**/*.env*", "effect": "deny" },
    { "action": "edit", "resource": "**/*secret*", "effect": "deny" },
    { "action": "edit", "resource": "**/*credential*", "effect": "deny" },
    { "action": "edit", "resource": "**/*.pem", "effect": "deny" },
    { "action": "edit", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "gthings", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.gnupg/**", "effect": "deny" }
  ]
}
